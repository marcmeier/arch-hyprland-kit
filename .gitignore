__pycache__/
*.pyc
*.bak*
*.tmp
.ruff_cache/
# systemctl --user enable writes its links into the linked folder
home/.config/systemd/user/*.wants/
home/.config/systemd/user/*.requires/
# alias links "systemctl --user enable" makes (wireplumber: pipewire-session-manager.service)
home/.config/systemd/user/pipewire-session-manager.service
# rendered per machine by theme/apply.py (wallpaper colours), never shared
home/.config/theme/colors.*
home/.config/theme/ghostty-colors
home/.config/theme/avatar.png
home/.config/hypr/hyprlock.conf
# nwg-displays creates these empty at start; its real output goes to ~/.local/state/hypr
home/.config/hypr/monitors.conf
home/.config/hypr/workspaces.conf
home/.config/walker/themes/driftless/style.css
home/.config/walker/themes/driftless-wallpapers/style.css
home/.config/emoji/list.txt
