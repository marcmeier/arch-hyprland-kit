# shellcheck shell=bash disable=SC2034 # read by the scripts that source this file
# Your personal settings: copy examples/personal to personal/ and fill in what you need. Read by
# driftless and by the dotfiles (as ~/.config/driftless/personal/config). Every value is optional.

# weather pill (wttr.in location; empty: guessed from your IP)
WTTR_LOCATION=""

# mirror countries for reflector, e.g. "Germany,Austria" (install/bootstrap.sh)
REFLECTOR_COUNTRY=""

# dictation (SUPER + D): language (de, en, ... or auto), the Ollama model that tidies the text up ("off":
# Whisper's text as it is), the Whisper model and words Whisper should know (names, terms)
DICTATE_LANG=auto
DICTATE_LLM=gemma3:4b
DICTATE_WHISPER_MODEL=large-v3-turbo-q5_0
DICTATE_PROMPT=""

# asking Claude by voice (SUPER + A): the Claude model, the language for Whisper (empty: DICTATE_LANG),
# the Piper voice (empty: de_DE-thorsten-high for German, en_US-lessac-high otherwise; "off": not
# spoken; https://huggingface.co/rhasspy/piper-voices) and the notes file ("Note: ...";
# empty: ~/Documents/notes.md)
NOTCH_MODEL=haiku
NOTCH_LANG=""
NOTCH_VOICE=""
NOTCH_NOTES=""

# the wallpaper folder of the settings menu; point it at a folder your cloud client syncs to have the
# same wallpapers on every machine (empty: ~/Pictures/Wallpapers)
WALLPAPER_DIR=""

# where Claude Code starts (SUPER + SHIFT + C)
CLAUDE_WORKDIR="$HOME"

# a full copy of the repository with history, refreshed by the sync (restore: git clone FILE)
BUNDLE=""

# moving from arch-hyprland-kit v1: links that keep this machine's live version
MIGRATE_ADOPT=()

# install/install-base.sh defaults for a new machine
DEFAULT_USER=user
DEFAULT_KEYMAP=us
DEFAULT_TIMEZONE=UTC
