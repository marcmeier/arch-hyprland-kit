# Matches waybar / wlogout / mako / walker. Stock config was empty: config.ghostty.bak-default

font-family = JetBrainsMono Nerd Font
font-size = 12

window-padding-x = 14
window-padding-y = 12
window-decoration = none
confirm-close-surface = false

background-opacity = 0.94
background-blur = 20

cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

background = 14161c
foreground = d7dce2
cursor-text = 14161c
selection-background = 2a3a48
selection-foreground = d7dce2

palette = 0=#1c1f26
palette = 1=#ff5f6d
palette = 2=#3ddc97
palette = 3=#ffb454
palette = 4=#5aa9ff
palette = 5=#c792ea
palette = 7=#d7dce2
palette = 8=#4b5263
palette = 9=#ff7a85
palette = 11=#ffcc80
palette = 12=#7fc4ff
palette = 13=#d7a8ff
palette = 14=#7fdbca
palette = 15=#ffffff

# accent colours follow the wallpaper (generated by ~/.config/theme/apply.py)
config-file = ../theme/ghostty-colors
