// Matches the desktop theme: colour names are ghostty palette slots, so they follow the wallpaper
// (cyan = primary accent, light_green = secondary, 90 = dark gray). Logo: the Arch logo in both
// accents; in a local Ghostty the fastfetch function in ~/.bashrc swaps in the round avatar.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": { "1": "cyan", "2": "light_green" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "light_green", "separator": "90" },
    "key": { "width": 10 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "󰣇 os" },
    { "type": "kernel", "key": " kernel" },
    { "type": "uptime", "key": "󰅐 uptime" },
    { "type": "packages", "key": "󰏖 pkgs" },
    { "type": "wm", "key": " wm" },
    { "type": "terminal", "key": " term" },
    { "type": "cpu", "key": " cpu" },
    { "type": "gpu", "key": "󰢮 gpu" },
    { "type": "memory", "key": "󰍛 mem" },
    { "type": "disk", "key": "󰋊 disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
