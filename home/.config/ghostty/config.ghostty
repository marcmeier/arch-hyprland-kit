# Matches the shell (bar, notifications, lock screen) and walker. Stock config was empty: config.ghostty.bak-default

font-family = JetBrainsMono Nerd Font
font-size = 12

window-padding-x = 14
window-padding-y = 12
window-decoration = none
confirm-close-surface = false

background-blur = 20

cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

# colours: the dark or the light look with the wallpaper's accents (generated by ~/.config/theme/apply.py)
config-file = ../theme/ghostty-colors
