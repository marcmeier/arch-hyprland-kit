# rendered by theme/apply.py into ~/.config/btop/themes/driftless.theme (btop.conf: color_theme = "driftless")
# Boxes and graphs in the wallpaper accents, in the dark or the light look; the load gradients end in red.
theme[main_bg]="@bg@"
theme[main_fg]="@fg@"
theme[title]="@fg@"
theme[hi_fg]="@primary@"
theme[selected_bg]="@primary_dim@"
theme[selected_fg]="@on_dim@"
theme[inactive_fg]="@faint@"
theme[graph_text]="@fg@"
theme[meter_bg]="@line@"
theme[proc_misc]="@secondary@"
theme[cpu_box]="@primary_dim@"
theme[mem_box]="@primary_dim@"
theme[net_box]="@primary_dim@"
theme[proc_box]="@primary_dim@"
theme[div_line]="@line@"
theme[temp_start]="@primary@"
theme[temp_mid]="@secondary@"
theme[temp_end]="@red@"
theme[cpu_start]="@primary@"
theme[cpu_mid]="@secondary@"
theme[cpu_end]="@red@"
theme[free_start]="@primary_dim@"
theme[free_mid]="@primary@"
theme[free_end]="@primary@"
theme[cached_start]="@secondary_dim@"
theme[cached_mid]="@secondary@"
theme[cached_end]="@secondary@"
theme[available_start]="@primary_dim@"
theme[available_mid]="@primary@"
theme[available_end]="@primary@"
theme[used_start]="@primary@"
theme[used_mid]="@secondary@"
theme[used_end]="@red@"
theme[download_start]="@primary_dim@"
theme[download_mid]="@primary@"
theme[download_end]="@primary@"
theme[upload_start]="@secondary_dim@"
theme[upload_mid]="@secondary@"
theme[upload_end]="@secondary@"
theme[process_start]="@primary@"
theme[process_mid]="@secondary@"
theme[process_end]="@red@"
