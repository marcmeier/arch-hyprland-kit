// -*- mode: jsonc -*-
// Compact layout for narrow monitors, merged over config.jsonc by render.py
// (objects merge key by key, lists replace; modules without a definition, e.g. battery
// on a desktop, are dropped). Same pills in the same order as config.jsonc, fewer words: details live
// in the tooltips.
{
    "spacing": 6,

    // avatar only, the name is decoration
    "group/user": { "modules": ["custom/avatar"] },

    // app glyph + app name; the full title stays in the tooltip (and the media pill shows what plays)
    "custom/window": { "exec": "cat \"$XDG_RUNTIME_DIR/driftless-bar/window-compact.json\" 2> /dev/null" },

    // the island: time · weather · agenda (icon lights up when an event is coming, list in the tooltip)
    "custom/calendar": { "exec": "~/.config/waybar/calendar.sh compact" },

    // play/pause + scrolling title; scroll on the title skips tracks
    "group/media": { "modules": ["custom/media-play", "custom/media"] },
    "custom/media": { "exec": "cat \"$XDG_RUNTIME_DIR/driftless-bar/media-compact.json\" 2> /dev/null" },

    // only the limit that is closer to running out
    "custom/claude": { "exec": "~/.config/waybar/claude-usage.py compact" },

    // status pill in quick-settings style: monochrome icons, numbers in the tooltips (battery keeps its %)
    "network": {
        "format-wifi": "",
        "tooltip-format-wifi": "{essid}  ·  {signalStrength}%\n{ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "tooltip-format": "{desc}  ·  {volume}%\nClick: next output  ·  Middle: mixer  ·  Right: mute  ·  Scroll: volume"
    },
    // one space after the battery glyph, as tight as the other icons (config.jsonc leaves two)
    "battery": { "format": "{icon} {capacity}%" },

    // tray icons at the height of the font glyphs next to them (style-compact.css), one gap everywhere
    "tray": { "icon-size": 13, "spacing": 8 }
}
