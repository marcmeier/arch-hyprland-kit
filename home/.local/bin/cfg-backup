#!/usr/bin/env bash
# Usage: cfg-backup FILE...   -> copies each FILE next to itself as FILE.bak-YYYYMMDD-HHMMSS (never overwrites).
set -euo pipefail
[[ $# -gt 0 ]] || {
  echo "usage: cfg-backup FILE..." >&2
  exit 1
}
ts=$(date +%Y%m%d-%H%M%S)
# -a preserves permissions/timestamps, -n never clobbers an existing backup with the same timestamp
for f in "$@"; do cp -an -- "$f" "$f.bak-$ts" && echo "$f.bak-$ts"; done
