<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- driftless: the two things the desktop may do as root, each with the password every time -->
<policyconfig>
  <action id="org.driftless.install-packages">
    <description>Install packages from the driftless lists</description>
    <message>driftless wants to install packages your other machines have: $(command_line)</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/driftless/install-packages</annotate>
  </action>
  <action id="org.driftless.greeter-update">
    <description>Update the login screen</description>
    <message>Show the new wallpaper and colours on the login screen</message>
    <icon_name>preferences-desktop-wallpaper</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/driftless/greeter-update</annotate>
  </action>
</policyconfig>
